# 1. Supabase Settings (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 2. Web Push Notification Keys (VAPID)
# You can generate new keys using `npx web-push generate-vapid-keys` or use the defaults below:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKSpHSZ7unZGp2DeQk2oO2WWDodLqf5S-1StWYJ3Wqvy_LeU51Mnbb5O_Md0Q6q1ficr9ytjPrzrAvI-REtjPzg
VAPID_PRIVATE_KEY=XHzsGbrnI5Y8PN-NV2MiHrVi837fAWl0oUCyKy-PLqw

# 3. SMS Gateway Key (Optional - Fast2SMS API key for emergency SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key_or_dummy_key
